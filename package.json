{
  "name": "potree",
  "version": "2.0.0-alpha.1",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "type": "module",
  "main": "./dist/potree.cjs",
  "module": "./dist/potree.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/potree.js",
      "require": "./dist/potree.cjs"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./css": "./dist/potree.css"
  },
  "files": [
    "dist",
    "types",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "three": ">=0.124.0"
  },
  "devDependencies": {
    "three": "^0.124.0",
    "vite": "^5.4.14"
  },
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.10",
    "@tweenjs/tween.js": "^18.6.4",
    "copc": "^0.0.9",
    "d3": "^3.5.17",
    "i18next": "^26.5.6",
    "jquery": "^4.0.0",
    "json5": "^2.2.3",
    "laz-perf": "^0.0.7",
    "proj4": "^2.15.0",
    "shapefile": "^0.6.6",
    "sql.js": "^1.15.1",
    "zstd-codec": "^0.1.5"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-Clause"
}
