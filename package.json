{
  "name": "potree",
  "version": "2.0.0-alpha.1",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "type": "module",
  "main": "./dist/potree.cjs",
  "module": "./dist/potree.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/potree.js",
      "require": "./dist/potree.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./css": "./dist/potree.css"
  },
  "files": [
    "dist",
    "types",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "three": ">=0.124.0",
    "jquery": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "three": "^0.124.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.14",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.10",
    "@tweenjs/tween.js": "^18.6.4",
    "copc": "^0.0.9",
    "i18next": "^26.5.6",
    "json5": "^2.2.3",
    "laz-perf": "^0.0.7",
    "proj4": "^2.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shapefile": "^0.6.6",
    "sql.js": "^1.15.1",
    "zstd-codec": "^0.1.5"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-Clause"
}
